{
  "name": "ezparts",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "catalog:check-verified-bundle": "node scripts/catalog/check_verified_catalog_bundle.mjs",
    "catalog:check-security": "node scripts/catalog/check_supabase_security.mjs",
    "catalog:build-three-machine-staging": "node scripts/catalog/build_three_machine_pilot_staging.mjs",
    "catalog:build-review-template": "node scripts/catalog/build-review-manifest-template.mjs",
    "catalog:bulk-promote": "node scripts/catalog/bulk-promote-staged-jobs.mjs",
    "catalog:bulk-review": "node scripts/catalog/bulk-review-staged-jobs.mjs",
    "catalog:prepare-macdon-review": "node scripts/catalog/prepare-macdon-review-manifest.mjs",
    "catalog:build-serial-index": "node scripts/catalog/build_serial_lookup_index.mjs",
    "catalog:prepare-three-machine-review": "node scripts/catalog/prepare-three-machine-review-manifest.mjs",
    "catalog:promote": "node scripts/catalog/promote-staged-job.mjs",
    "catalog:review": "node scripts/catalog/review-staged-job.mjs",
    "catalog:stage-batch": "node scripts/catalog/stage-manual-bundle-batch.mjs",
    "catalog:stage-bundle": "node scripts/catalog/stage-manual-bundle.mjs",
    "catalog:sync-manuals": "node scripts/catalog/sync-machine-source-documents.mjs",
    "catalog:check-manuals": "node scripts/catalog/sync-machine-source-documents.mjs --check",
    "catalog:hotspot-scaffold": "node scripts/catalog/build_diagram_hotspot_scaffold.mjs",
    "catalog:upload-diagrams": "node scripts/catalog/upload_diagrams_to_supabase.mjs",
    "catalog:validate": "node scripts/catalog/validate-migrations.mjs",
    "dev": "vite",
    "prebuild": "npm run catalog:check-verified-bundle",
    "build": "vite build && node scripts/catalog/prune_bundled_diagrams.mjs dist",
    "preview": "vite preview",
    "sync:ios": "npx cap sync ios && node scripts/catalog/prune_bundled_diagrams.mjs ios/App/App/public",
    "refresh:ios": "npm run build && npm run sync:ios",
    "test:js": "node --experimental-specifier-resolution=node --test src/lib/pilot-catalog.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@stripe/react-stripe-js": "^6.6.0",
    "@stripe/stripe-js": "^9.8.0",
    "@supabase/supabase-js": "^2.38.0",
    "pg": "^8.23.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "stripe": "^22.2.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@vitejs/plugin-react": "^4.0.0",
    "vite": "^4.3.0"
  }
}
